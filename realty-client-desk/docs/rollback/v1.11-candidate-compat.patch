diff --git realty-client-desk/tests/compatCandidate.test.mjs realty-client-desk/tests/compatCandidate.test.mjs
new file mode 100644
index 0000000..854d297
--- /dev/null
+++ realty-client-desk/tests/compatCandidate.test.mjs
@@ -0,0 +1,41 @@
+// v1.11 호환판(C-1 롤백용, 2026-11-20, Mac 검수 msg_e76ff8708dd4 반영): 기존 후보는 유지, 일반 매물 → 후보는 금지
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { CANDIDATE_STATUS, LISTING_STATUSES, statusOptions } from "../src/lib/desk/adRules.ts";
+
+/** 브라우저 <select defaultValue>: 값이 선택지에 있으면 그 값, 없으면 첫 값 */
+const selected = (options, value) => (options.includes(value) ? value : options[0]);
+
+test("기존 후보 줄: 선택지에 「후보」가 있어 그대로 저장해도 후보 유지(광고 중으로 바뀌지 않음)", () => {
+  const opts = statusOptions("후보");
+  assert.ok(opts.includes("후보"));
+  assert.equal(selected(opts, "후보"), "후보");
+  for (const s of ["광고 중", "계약", "내림"]) assert.ok(opts.includes(s), `후보에서 ${s}(으)로는 바꿀 수 있음`);
+});
+
+test("일반 매물 줄: 「후보」 선택지 없음, 기존 세 값·첫 값 「광고 중」 그대로", () => {
+  for (const cur of ["광고 중", "계약", "내림"]) {
+    const opts = statusOptions(cur);
+    assert.deepEqual([...opts], ["광고 중", "계약", "내림"]);
+    assert.equal(selected(opts, cur), cur);
+  }
+  assert.deepEqual(LISTING_STATUSES.slice(0, 3), ["광고 중", "계약", "내림"]);
+  assert.equal(CANDIDATE_STATUS, "후보");
+});
+
+test("서버: 「후보」로 저장하는 요청은 이미 후보인 행에만 적용되는 조건이 있다(화면 우회 요청 차단)", () => {
+  const src = readFileSync(new URL("../src/lib/actions/listings.ts", import.meta.url), "utf8");
+  const fn = src.slice(src.indexOf("export async function updateListingStatusAction"));
+  const next = fn.indexOf("export async function", 10);
+  const body = next > 0 ? fn.slice(0, next) : fn; // 줄바꿈(LF·CRLF)과 무관하게 다음 함수 앞까지
+  assert.ok(body.length > 100, "함수 본문을 찾음");
+  assert.match(body, /if \(status === CANDIDATE_STATUS\) q = q\.eq\("status", CANDIDATE_STATUS\)/);
+  assert.match(body, /\.eq\("user_id", user\.id\)/);
+});
+
+test("새 후보를 만드는 경로가 없다(후보 등록 액션·화면 없음)", () => {
+  const src = readFileSync(new URL("../src/lib/actions/listings.ts", import.meta.url), "utf8");
+  assert.doesNotMatch(src, /addCandidateListingAction/);
+  assert.doesNotMatch(src, /status: "후보"/);
+});
