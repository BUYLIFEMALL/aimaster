diff --git realty-client-desk/tests/compatCandidate.test.mjs realty-client-desk/tests/compatCandidate.test.mjs
new file mode 100644
index 0000000..4bf01b3
--- /dev/null
+++ realty-client-desk/tests/compatCandidate.test.mjs
@@ -0,0 +1,18 @@
+// v1.11 호환판(C-1 롤백용, 2026-11-20): 「후보」 행이 옛 화면에서 「광고 중」으로 바뀌지 않는지 — PLAN §6-2 (가)
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { LISTING_STATUSES } from "../src/lib/desk/adRules.ts";
+
+/** 브라우저 <select defaultValue>: 값이 목록에 있으면 그 값, 없으면 첫 값이 선택된다 */
+const selected = (value) => (LISTING_STATUSES.includes(value) ? value : LISTING_STATUSES[0]);
+
+test("후보 줄의 상태 선택은 「후보」로 보이고, 그대로 「상태 저장」하면 후보가 유지된다", () => {
+  assert.ok(LISTING_STATUSES.includes("후보"));
+  assert.equal(selected("후보"), "후보");
+  assert.notEqual(selected("후보"), "광고 중");
+});
+
+test("기존 세 상태는 그대로(순서·첫 값 「광고 중」 유지)", () => {
+  assert.deepEqual(LISTING_STATUSES.slice(0, 3), ["광고 중", "계약", "내림"]);
+  for (const s of ["광고 중", "계약", "내림"]) assert.equal(selected(s), s);
+});
