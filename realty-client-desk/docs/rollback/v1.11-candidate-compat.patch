-export const LISTING_STATUSES = ["광고 중", "계약", "내림"] as const;
+export const LISTING_STATUSES = ["광고 중", "계약", "내림", "후보"] as const;
+// v1.11 호환판(C-1 롤백용, 2026-11-20): 「후보」는 v1.12에서 이미 저장된 행을 지키기 위한 값이다.
+// 이 판에는 새 후보를 만드는 경로가 없고, 일반 매물을 「후보」로 바꾸는 것도 화면·서버 모두 막는다.
+export const CANDIDATE_STATUS = "후보";
+/** 상태 선택지: 이미 후보인 줄만 「후보」를 보이고(그대로 저장해도 후보 유지), 그 밖의 줄은 기존 세 값만 */
+export function statusOptions(current: string): readonly string[] {
+  return current === CANDIDATE_STATUS ? LISTING_STATUSES : LISTING_STATUSES.filter((s) => s !== CANDIDATE_STATUS);
+}
 
