{
 "_about": "리믹스 가사 보존 합성 표본(REMIX-LYRICS-FIXTURE-PLAN A1→A2→A3→A4, 2026-11-20 Claud(Music)). 시험 코드에 연결하지 않은 설계 자료다. 가사 문자열은 모두 지어낸 짧은 표본이며 실제 회원 가사가 아니다.",
 "_basisLegend": {
  "OBS": "저장소에 남은 실제 응답 처리 기록 — record-info sunoData[]에서 id·audioUrl·streamAudioUrl·imageUrl·duration을 읽은 기록뿐(fix-stuck-track.mjs 68~104). 다른 칸(가사 포함)의 있고 없음은 미관측",
  "CODE": "우리 코드 동작으로 정해지는 기대값(웹훅 task_id 조회·상태·잠금, remixSync 저장 순서)",
  "DOC": "문서에만 있는 형태 — 콜백 data.data[].prompt (music/docs/SUNOAPI_REFERENCE.md 51줄). record-info에 같은 칸이 있는지는 미관측",
  "ASSUME": "근거 없는 가정 — lyrics·lyric 같은 다른 칸 이름. 이 칸의 문자열은 가사로 확정하지 않는다",
  "SYNTH": "합성 입력 — 실측·문서 근거 없이 경계 검증용으로 만든 값"
 },
 "_rules": {
  "acceptedLyricsField": "prompt 하나만 가사 후보(DOC). 실측 전 상태는 provided_unverified. prompt 칸 자체가 없으면 unknown",
  "guessedFields": "lyrics·lyric 등 다른 이름의 문자열은 저장하지 않고 상태 unknown, 진단 표시 guessedFieldSeen=true만 남긴다",
  "absent": "가사 칸이 아예 없으면 unknown(empty 아님)",
  "pairing": "가사와 행의 짝은 sunoData 배열 순서가 아니라 항목 id(= suno_audio_id) 기준",
  "instructionEcho": "보낸 영어 지시문과 정규화 뒤 같거나 지시문 첫 문장으로 시작하면 empty",
  "output": "시험 비교는 (audioId, taskId, hop, status, lyricsLen, lyricsHash)만. lyricsHash = NFC 정규화 문자열 sha256 앞 16자. 가사 원문을 시험 출력·로그에 찍지 않는다",
  "memberPriority": "회원이 직접 넣은 가사(music_track_remixes.lyrics)가 있으면 가사 영상 본문은 항상 회원 원문 — Suno prompt(provided_unverified)는 저장만 하고 본문을 덮지 않는다",
  "casConditions": "잠금·저장·완료·실패·연장 갱신은 모두 (id, task_id = 처리 중인 taskId, extend_hop_count = 읽은 hop, status = generating) 조건을 함께 건다. 조건이 맞지 않으면 아무것도 바꾸지 않고 ignored",
  "lock": "잠금은 처리마다 새 토큰. 조건 = id + task_id + extend_hop_count + generating + (잠금 비었거나 5분 지남). 모든 쓰기는 같은 조건 + 토큰 일치, 다르면 0행",
  "atomic": "변주 넣기 + 리믹스 상태 변경(완료·연장 예약·잠금 해제)은 DB 함수 하나(트랜잭션). 실패 시 전부 되돌림",
  "extend": "연장은 예약(세대 gen+1·소유 토큰·만료 시각) → 전송 → 확정(task_id 기록, 조건 gen·토큰·task_id null·만료 전). 분명한 거절 근거가 있을 때만 extendFailed, 그 밖(시간 초과·연결 끊김·5xx·본문 해석 불가·문서 불일치 코드·taskId 없는 성공 응답·만료된 예약)은 모두 extendUncertain. 어느 경우에도 자동 재발송 0",
  "backfill": "완료 리믹스의 본인 unknown 변주만. 출처 = suno_task_id, 없으면 hop 0 리믹스의 task_id만. suno_task_id 없는 옛 연장 행은 조회 0회·unknown 유지(오디오 id가 겹쳐도). 갱신 조건 id + user_id + lyrics_status = unknown",
  "definiteRejection": "HTTP 응답을 받았고 + 본문 JSON을 해석했고 + 본문 code가 400·401·404·413 중 하나이며 HTTP 상태와 같고 + 본문에 taskId가 없을 때만. 405·429·430·455는 문서끼리 뜻이 엇갈려(SUNOAPI_REFERENCE 59줄) 불확실로 본다",
  "backfillGuard": "보충 UPDATE 한 문장의 WHERE에 모두: variant.id·user_id(본인)·remix_id 일치, lyrics_status='unknown', 리믹스 user_id 본인·status='completed'·lyrics(회원 원문) 비어 있음, 출처 = (variant.suno_task_id = 조회한 taskId) 또는 (variant.suno_task_id is null and remix.extend_hop_count = 0 and remix.task_id = 조회한 taskId), variant.suno_audio_id = 응답 항목 id. 하나라도 어긋나면 0행"
 },
