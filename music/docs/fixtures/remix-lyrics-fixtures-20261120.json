{
  "_about": "리믹스 가사 보존 합성 표본(REMIX-LYRICS-FIXTURE-PLAN A1, 2026-11-20 Claud(Music)). 시험 코드에 연결하지 않은 설계 자료다. 가사 문자열은 모두 지어낸 짧은 표본이며 실제 회원 가사가 아니다.",
  "_basisLegend": {
    "OBS": "저장소에서 실제 응답으로 관찰된 형태 — record-info sunoData[] 항목의 낙타 표기 id·audioUrl·streamAudioUrl·imageUrl·duration (music/scripts/fix-stuck-track.mjs 68~104)",
    "CODE": "우리 코드 동작으로 정해지는 기대값(웹훅 task_id 조회·상태·잠금, remixSync 저장 순서)",
    "DOC": "문서에만 있는 형태 — 콜백 data.data[].prompt (music/docs/SUNOAPI_REFERENCE.md 51줄). record-info에 같은 칸이 있는지는 미관측",
    "ASSUME": "근거 없는 가정 — lyrics·lyric 같은 다른 칸 이름. 이 칸의 문자열은 가사로 확정하지 않는다"
  },
  "_rules": {
    "acceptedLyricsField": "prompt 하나만 가사 후보로 인정(DOC). 실측 1회로 record-info 칸 이름이 확인되기 전까지 상태는 provided가 아니라 provided_unverified로 저장한다",
    "guessedFields": "lyrics·lyric 등 다른 이름의 문자열은 저장하지 않고 상태 unknown, 진단 표시 guessedFieldSeen=true만 남긴다",
    "absent": "가사 칸이 아예 없으면 unknown(empty 아님)",
    "pairing": "가사와 행의 짝은 sunoData 배열 순서가 아니라 항목 id(= suno_audio_id) 기준",
    "instructionEcho": "보낸 영어 지시문과 정규화 뒤 같거나 지시문 첫 문장으로 시작하면 empty",
    "output": "시험 비교는 (audioId, taskId, status, lyricsLen)만. 가사 원문을 시험 출력에 찍지 않는다"
  },
  "_preconditions": [
    "웹훅 리믹스 조회 select(music/app/api/webhooks/suno/route.ts 104~106줄)에 지금 mode·lyrics·task_id가 없다 → 저장 단계에서 종류·지시문 판정을 하려면 이 세 칸을 함께 읽어야 한다(구현 항목)",
    "수동 동기화 경로(music/lib/actions/remix.ts 400줄 부근)도 같은 저장 함수를 쓰므로 같은 입력을 받아야 한다"
  ],
  "defaults": {
    "lang": "한국어",
    "instructionSolo": "Sing this song in 한국어, in the new style described above, keeping the same emotional theme and story as the original.",
    "instructionDuet": "Sing this song in 한국어, in the new style described above, keeping the same emotional theme and story as the original. Alternate between male and female vocals across different sections (verses and chorus), like a duet.",
    "extendInstruction": "Continue this remix naturally into a new section that fits the same style and mood as before, written in 한국어."
  },
  "cases": [
    {
      "id": "P0-PAIR-01", "priority": "P0", "theme": "ID 짝", "basis": ["OBS", "DOC"],
      "input": { "mode": "add_vocals", "instrumental": false, "userLyrics": null, "taskId": "T0", "hop": 0,
        "sunoData": [ { "id": "A", "audioUrl": "https://x/a.mp3", "prompt": "표본 가사 가" }, { "id": "B", "audioUrl": "https://x/b.mp3", "prompt": "표본 가사 나" } ] },
      "expected": [ { "audioId": "A", "taskId": "T0", "status": "provided_unverified", "lyricsLen": 7 }, { "audioId": "B", "taskId": "T0", "status": "provided_unverified", "lyricsLen": 7 } ],
      "assumedPart": "record-info에 prompt가 있다는 것(DOC→ASSUME)"
    },
