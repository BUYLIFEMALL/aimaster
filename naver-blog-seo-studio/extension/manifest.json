{
  "manifest_version": 3,
  "name": "AIMaster Naver Blog SEO Studio",
  "version": "1.0.2",
  "description": "SEO Studio 전용 네이버 블로그 초안 작성 및 입력 확장 프로그램",
  "permissions": ["sidePanel", "storage", "scripting", "tabs", "debugger"],
  "host_permissions": [
    "https://*.naver.com/*",
    "https://naver-blog-seo-studio.vercel.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Naver Blog SEO Studio" }
}
