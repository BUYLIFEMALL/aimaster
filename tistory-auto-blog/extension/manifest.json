{
  "manifest_version": 3,
  "name": "티스토리(원문) 입력기 · AIMaster",
  "version": "1.4.0",
  "version_name": "v1.04",
  "description": "티스토리(원문)생성 자동화의 글을 티스토리 글쓰기 화면에 입력하기 위한 확장 프로그램입니다. 현재는 화면 구조 확인 단계이며 글을 입력하거나 발행하지 않습니다.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.tistory.com/*",
    "https://tistory-auto-blog-pearl.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "티스토리(원문) 입력기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
