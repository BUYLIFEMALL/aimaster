{
  "manifest_version": 3,
  "name": "상품소싱 자동화",
  "version": "1.33.0",
  "version_name": "v1.33",
  "description": "회원이 고른 쿠팡 검색 화면(판매량순)의 상품을 읽어 판매 순위와 리뷰 수로 거르는 확장 프로그램",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_title": "쿠팡 상품소싱기",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "host_permissions": [
    "https://trending-product-finder.buylife.xyz/*",
    "https://www.coupang.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://trending-product-finder.buylife.xyz/*"
      ],
      "js": [
        "web-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
