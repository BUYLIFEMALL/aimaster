{
  "manifest_version": 3,
  "name": "상품소싱 자동화",
  "version": "1.38.0",
  "version_name": "v1.38",
  "description": "회원이 고른 쿠팡(판매량순)·네이버 쇼핑(랭킹순) 검색 화면의 상품을 읽어 판매 순위·리뷰 수·구매 수로 거르고, 상세페이지 기획용 참고 사진을 회원 브라우저로 받는 확장 프로그램",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_title": "상품소싱기 (쿠팡·스마트스토어)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "host_permissions": [
    "https://trending-product-finder.buylife.xyz/*",
    "https://www.coupang.com/*",
    "https://search.shopping.naver.com/*",
    "https://smartstore.naver.com/*",
    "https://brand.naver.com/*",
    "https://*.coupangcdn.com/*",
    "https://*.pstatic.net/*",
    "https://*.alicdn.com/*",
    "https://*.domeggook.com/*",
    "https://*.domeme.com/*",
    "https://*.011st.com/*",
    "https://*.11st.co.kr/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://trending-product-finder.buylife.xyz/*"
      ],
      "js": [
        "web-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
