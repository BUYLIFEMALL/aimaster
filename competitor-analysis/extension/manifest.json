{
  "manifest_version": 3,
  "name": "키워드·경쟁사 분석 자동화",
  "description": "제휴 타깃 찾기 — 주제에 맞는 채널의 공개 페이지에서 홍보용으로 공개된 이름·연락처를 회원님 PC에서 읽어 회원님 계정에 모읍니다.",
  "version": "1.13.0",
  "version_name": "v1.13",
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "제휴 타깃 스캔" },
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://competitor-analysis.buylife.xyz/*",
    "https://blog.naver.com/*", "https://m.blog.naver.com/*",
    "https://cafe.naver.com/*", "https://m.cafe.naver.com/*",
    "https://smartstore.naver.com/*", "https://m.place.naver.com/*", "https://map.naver.com/*"
  ]
}
