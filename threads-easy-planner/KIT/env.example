# Threads AI 기획 자동화 — 독립 운영 설정값 예시
# 패키지 설치마법사(패키지설치마법사.cmd / .command)를 쓰면 이 값들이 자동으로 .env.local 과 Vercel 에 들어갑니다.
# 손으로 설치할 때만: 이 파일을 프로그램 폴더에 .env.local 로 복사해 값을 채우고, Vercel → Settings → Environment Variables 에도 같은 값을 넣습니다.

# 반드시 true — AIMaster 없이 자체 가입·로그인으로 동작
NEXT_PUBLIC_STANDALONE_MODE=true

# 내 사이트 주소(끝에 / 없이). Vercel Domains 에 보이는 주소 또는 연결한 내 도메인
NEXT_PUBLIC_SITE_URL=https://my-threads-planner.vercel.app

# 브라우저 탭 제목에 표시할 내 이름/브랜드(비우면 표시 안 함)
NEXT_PUBLIC_BRAND_NAME=홍길동 마케팅

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_또는_anon_key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_또는_service_role_key_절대공개금지

# (마법사가 자동 생성 — 이 프로그램은 예약 실행이 없어 쓰지 않지만 넣어 두어도 됩니다)
CRON_SECRET=여기에_긴_무작위_문자열
