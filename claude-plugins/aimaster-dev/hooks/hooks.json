{
  "description": "AIMaster 최상위 지침의 금지 명령(공용 스테이징을 망가뜨리는 git 명령, .env 덮어쓰기)을 실행 전에 막는다",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
