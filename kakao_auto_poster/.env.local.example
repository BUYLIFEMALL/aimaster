# Supabase (프로젝트: AIMaster / esgxyikcnnvmlhygjkth — 다른 서브프로젝트와 동일 프로젝트 공유)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 사이트 기본 URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAIN_SITE_URL=https://buylife.xyz

# AI 키/카카오(SOLAPI) 연동은 전부 회원 본인이 /settings에서 등록하는 BYOK 방식이라
# 이 앱 자체의 환경변수로는 등록하지 않습니다 (user_api_keys / user_solapi_accounts 참고).

# 카카오 로그인("나에게 보내기" 무료 API) — https://developers.kakao.com 에서 앱 하나를
# 등록해 발급받는 "앱 레벨" 키다(threads의 THREADS_APP_ID/SECRET과 동일한 성격 — 회원 각자의
# 카카오 계정은 이 앱을 통해 개별적으로 로그인/동의한다). "카카오 로그인" 활성화 후
# 동의항목에서 talk_message를 사용 설정하고, Redirect URI에 아래 KAKAO_REDIRECT_URI를 그대로
# 등록해야 한다. Client Secret은 콘솔에서 "사용함"으로 켠 경우에만 필요하다(선택).
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/kakao/callback

# 예약 작업(cron) 보호용 — Phase 3(정기 자동 발송)에서 사용
CRON_SECRET=
