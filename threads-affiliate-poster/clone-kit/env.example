# Threads 쇼핑제휴 자동화 — 독립 운영(복제본) 환경변수
# Vercel → 프로젝트 → Settings → Environment Variables(Production)에 같은 이름으로 넣는다.
# 로컬에서 실행할 때만 이 파일을 .env.local로 복사해 값을 채운다. (.env.local은 절대 커밋하지 않는다)

# ── 필수 ─────────────────────────────────────────────
# 독립 운영 모드 켜기 (자체 회원가입·법적 고지 페이지 사용, AIMaster 연결 끄기)
NEXT_PUBLIC_STANDALONE_MODE=true

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 이 복제본의 실제 주소 (끝에 / 없이). Threads 로그인 콜백·가입 확인 메일·데이터 삭제 주소에 쓰인다.
NEXT_PUBLIC_SITE_URL=https://my-tap.vercel.app

# 개인정보처리방침·약관·데이터 삭제 안내 페이지에 표시되는 운영자 정보
NEXT_PUBLIC_OPERATOR_NAME=홍길동(상호명)
NEXT_PUBLIC_OPERATOR_EMAIL=help@example.com

# ── 예약 게시를 쓸 때 ────────────────────────────────
# 임의의 긴 문자열. cron-job.org가 Authorization: Bearer <이 값>으로 호출한다.
CRON_SECRET=

# ── 선택 기능 ───────────────────────────────────────
# 연동 매뉴얼 버튼을 보여줄 사이트 주소(그 사이트의 /guides/<id>를 연다). 비우면 버튼이 숨겨진다.
NEXT_PUBLIC_GUIDE_BASE_URL=

# 네이버 데이터랩 검색어 트렌드 (네이버 클라우드 API HUB에서 운영자가 발급)
NAVER_TREND_CLIENT_ID=
NAVER_TREND_CLIENT_SECRET=

# 토스쇼핑 쉐어링크: 토스가 고정 IP만 허용하므로 Fixie 등 고정 IP 프록시 주소
FIXIE_URL=

# 이미지 생성 모델 이름을 바꿀 때만 (기본 nanobanana-2-2k)
GEMINI_IMAGE_MODEL=

# ※ THREADS_APP_ID / THREADS_APP_SECRET / OPENAI_API_KEY 등은 넣지 않는다.
#   회원이 설정 화면(API키등록·플랫폼연동)에서 본인 것을 등록해서 쓰는 구조다.
