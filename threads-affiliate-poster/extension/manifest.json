{
  "manifest_version": 3,
  "name": "Threads 쇼핑제휴 자동화",
  "version": "1.89.0",
  "version_name": "v1.89",
  "minimum_chrome_version": "120",
  "description": "네이버 브랜드커넥트 naver.me 링크를 내 브라우저에서 열어 실제 상품 페이지의 상품명·이미지·후기를 Threads 쇼핑제휴 자동화로 가져옵니다.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://threads-affiliate-poster.buylife.xyz/*",
    "https://naver.me/*",
    "https://brand.naver.com/*",
    "https://smartstore.naver.com/*",
    "https://shopping.naver.com/*",
    "https://pkgtour.naver.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://threads-affiliate-poster.buylife.xyz/*"
      ],
      "js": [
        "web-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
