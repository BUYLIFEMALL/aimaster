# Supabase (AIMaster와 동일한 프로젝트를 공유)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 클라이언트 코드나 NEXT_PUBLIC_ 접두사로 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 사이트 기본 URL
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# AIMaster(회원가입/구독/결제 통합 플랫폼) URL
# 구독 권한 없을 때 이동할 프로그램 구매 페이지에 사용
NEXT_PUBLIC_MAIN_SITE_URL=https://buylife.xyz

# OpenAI (쇼츠 주제/스크립트 정리 생성, 사용자가 본인 키 미등록 시 폴백)
OPENAI_API_KEY=

# Perplexity (실시간 트렌드 검색, 사용자가 본인 키 미등록 시 폴백)
PERPLEXITY_API_KEY=

# Gemini (스크립트/나노바나나 이미지 생성, 사용자가 본인 키 미등록 시 폴백)
GEMINI_API_KEY=

# Suno (배경음악 생성, 사용자가 본인 키 미등록 시 폴백)
SUNO_API_KEY=

# Google OAuth (유튜브 채널 연결/업로드용, Google Cloud Console에서 발급)
# YouTube Data API v3 활성화 + youtube.upload, youtube.readonly 스코프 필요
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_YOUTUBE_REDIRECT_URI=http://localhost:3002/api/youtube/callback

# Meta App (인스타그램 릴스 연결/업로드용, Meta for Developers에서 발급)
# Instagram Graph API + Facebook Login 제품 필요
META_APP_ID=
META_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=http://localhost:3002/api/instagram/callback
