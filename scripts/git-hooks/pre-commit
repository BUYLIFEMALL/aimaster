#!/bin/sh
# AIMaster 커밋 직전 알림(2026-10-20) — 이번 커밋에 시험 안 한 OpenAI 모델 이름이 추가되면 경고만 띄운다.
# 커밋은 절대 막지 않는다(node가 없거나 오류가 나도 그대로 진행). 설치: node scripts/git-hooks/install.mjs
command -v node >/dev/null 2>&1 || exit 0
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$root/scripts/check-openai-models.mjs" ] || exit 0
node "$root/scripts/check-openai-models.mjs" --staged 2>/dev/null || true
exit 0
