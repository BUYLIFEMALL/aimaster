#!/bin/sh
# AIMaster 커밋 직전 검사(2026-10-20) — 이번 커밋에 시험 안 한 OpenAI 모델 이름이 추가되면 경고만 띄운다.
# 경고들은 커밋을 막지 않는다(node가 없거나 오류가 나도 그대로 진행). 단, 맨 아래 대량 삭제 검사만은 커밋을 막는다. 설치: node scripts/git-hooks/install.mjs
# 2026-10-23 정정: 04b887892에서 대량 삭제 검사 블록이 `|| exit 0` 자리에 끼어들어, node가 있으면 첫 줄에서 바로 끝나 모든 검사가 돌지 않았다 — 원래 순서로 되돌림.
command -v node >/dev/null 2>&1 || exit 0
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$root/scripts/check-openai-models.mjs" ] && { node "$root/scripts/check-openai-models.mjs" --staged 2>/dev/null || true; }
# 2026-10-23: 공용 스크립트(deploy.mjs 등)를 일반 git commit으로 올리면 막는다 — 다른 세션 미커밋 수정이 섞이는 사고(48b3fc4d0) 재발 방지. 안전 커밋 도우미는 이 훅을 거치지 않음
if [ -f "$root/scripts/check-shared-doc-reverts.mjs" ]; then node "$root/scripts/check-shared-doc-reverts.mjs" --block-scripts || exit 1; fi
# 2026-10-23: 공용 문서(HANDOFF 등)에서 최근 2시간 안 다른 커밋이 넣은 줄을 지우면 경고(커밋은 계속) — docs/PROPOSAL_20261023_SHARED_DOC_OVERWRITE.md 방안 B
[ -f "$root/scripts/check-shared-doc-reverts.mjs" ] && { node "$root/scripts/check-shared-doc-reverts.mjs" --staged || true; }
# 2026-10-23 공용 스테이징 블랙박스 — 커밋 때마다 index 크기·항목 수를 .git/aimaster-index-log.txt에 한 줄(축소 원인 추적용, 막지 않음)
[ -f "$root/scripts/index-watch.mjs" ] && { node "$root/scripts/index-watch.mjs" pre-commit --quiet </dev/null || true; }
# 2026-10-23 저장소 대량 삭제 사고(c2e7c4db2) 재발 방지 — 파일을 50개 넘게 지우거나 스테이징이 쪼그라들었으면 커밋을 막는다(루트 CLAUDE.md 최상단)
if [ -f "$root/scripts/check-index-health.mjs" ]; then node "$root/scripts/check-index-health.mjs" --staged || exit 1; fi
exit 0
