NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=https://naver-cafe-poster.vercel.app
NEXT_PUBLIC_MAIN_SITE_URL=https://buylife.xyz

# 네이버 로그인(Client ID/Secret)은 2026-09-16부터 회원 본인이 /settings에서 등록하는
# BYOK 방식으로 바뀌어(user_api_keys의 naver_client_id/naver_client_secret) 더 이상 이 앱의
# 환경변수로 두지 않는다(네이버 앱이 검수를 통과하지 않은 동안은 테스터로 등록된 계정만
# 로그인 가능해, 앱 공용 키 하나로는 운영자 본인 외 다른 회원이 연동할 수 없었기 때문 —
# kakao_auto_poster의 KAKAO_REST_API_KEY 전환과 동일한 이유). Redirect URI만은 이 앱의 고정
# 배포 도메인 기준이라 여전히 환경변수로 둔다 — 회원이 본인 네이버 앱을 만들 때도 이 값을
# 그대로 Callback URL에 등록해야 한다.
NAVER_REDIRECT_URI=https://naver-cafe-poster.vercel.app/api/naver/callback

# 예약(정기 자동 생성+포스팅) 크론 보호용 — Vercel Cron이 이 값을 Authorization 헤더로 실어
# /api/cron/generate-and-post를 호출한다. 아무 임의 문자열이나 발급해 등록하면 된다(외부
# 서비스 키 아님).
CRON_SECRET=
