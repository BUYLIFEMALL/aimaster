{
  "manifest_version": 3,
  "name": "상가·건물·토지 매물 알림",
  "version": "1.15.0",
  "version_name": "v1.15",
  "description": "회원 PC에서 회원 본인 계정으로 네이버 상가·건물·토지 매물 화면을 읽어 변동을 본인 텔레그램·이메일·카카오톡으로 알려 줍니다.",
  "permissions": [
    "debugger",
    "alarms",
    "storage",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "https://new.land.naver.com/*",
    "https://api.telegram.org/*",
    "https://api.resend.com/*",
    "https://kapi.kakao.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://commercial-land-trade-alert.buylife.xyz/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://commercial-land-trade-alert.buylife.xyz/*"
      ],
      "js": [
        "web-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "상가·건물·토지 매물 알림"
  }
}
