{
  "manifest_version": 3,
  "name": "상가·건물·토지 매물·실거래 알림",
  "version": "1.1.0",
  "description": "0단계 사전 검증: 지금 탭이 스스로 받은 네이버 부동산 응답의 칸 이름과 표본만 기록합니다. 네이버에 요청을 보내지 않고, 파일은 내 PC에만 저장합니다.",
  "permissions": [
    "debugger",
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://new.land.naver.com/*",
    "https://fin.land.naver.com/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "매물 사전 검증"
  },
  "version_name": "v1.01"
}
