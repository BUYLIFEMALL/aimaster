{
  "manifest_version": 3,
  "name": "부동산 사전 검증(임시)",
  "version": "0.0.1",
  "description": "realty-listing-alert 0단계 사전 검증용 임시 확장. 검증 뒤 삭제.",
  "permissions": ["debugger", "alarms", "storage", "downloads"],
  "host_permissions": ["https://new.land.naver.com/*", "https://fin.land.naver.com/*", "https://m.land.naver.com/*", "https://api.telegram.org/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "부동산 사전 검증" }
}
