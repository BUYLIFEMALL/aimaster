{
  "manifest_version": 3,
  "name": "AI G마켓·옥션 상품 자동등록기",
  "version": "1.1.0",
  "version_name": "v1.01",
  "minimum_chrome_version": "120",
  "description": "AI 상세페이지 자동화로 만든 상품을 ESM+ 「상품등록」 화면에 칸마다 채워 G마켓·옥션에 한 번에 올립니다.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://esm-register.buylife.xyz/*",
    "https://item.esmplus.com/*",
    "https://www.esmplus.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://esm-register.buylife.xyz/*"
      ],
      "js": [
        "web-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI G마켓·옥션 상품 자동등록기",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
