# INSTA 포스팅 자동화 — 독립 운영 설정값 예시
# 이 파일을 프로그램 폴더에 .env.local 로 복사해 값을 채우고, Vercel → Settings → Environment Variables 에도 같은 값을 넣습니다.
# (설치 스크립트 KIT/setup.ps1 · KIT/setup.sh 를 쓰면 자동으로 만들어집니다)

# 반드시 true — AIMaster 없이 자체 가입·로그인으로 동작(buylife.xyz 주소 이동도 꺼짐)
NEXT_PUBLIC_STANDALONE_MODE=true

# 내 사이트 주소(끝에 / 없이). Vercel Domains 에 보이는 주소 또는 연결한 내 도메인
NEXT_PUBLIC_SITE_URL=https://my-insta.vercel.app

# 화면 제목·로그인 화면·좌측 메뉴에 표시할 내 이름/브랜드(비우면 표시 안 함)
NEXT_PUBLIC_BRAND_NAME=홍길동 마케팅

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_또는_anon_key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_또는_service_role_key_절대공개금지

# 예약 게시 실행 주소를 보호하는 비밀값. cron-job.org 헤더 Authorization: Bearer <이 값>
CRON_SECRET=여기에_긴_무작위_문자열
