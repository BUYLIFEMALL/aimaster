# Supabase (AIMaster 전체가 공유하는 프로젝트)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 클라이언트 코드나 NEXT_PUBLIC_ 접두사로 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# AIMaster(회원가입/구독/결제 통합 플랫폼) URL
# 로그인 후 리다이렉트, 구독 권한 없을 때 이동할 프로그램 구매 페이지에 사용
NEXT_PUBLIC_MAIN_SITE_URL=https://buylife.xyz

# 로컬에서 "긴 이미지 다운로드"(Puppeteer) 테스트 시 설치된 Chrome 경로가 다르면 지정
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# 주의: ANTHROPIC_API_KEY / GEMINI_API_KEY / OPENAI_API_KEY / REPLICATE_API_TOKEN은
# 여기 등록하지 않는다. 관리자 공용 키로 폴백하지 않는 정책이라(README "설계 배경" 참고),
# 모든 사용자는 반드시 로그인 후 /settings 화면에서 본인 키를 등록해야 생성 기능을 쓸 수 있다.
