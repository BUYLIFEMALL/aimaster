{
  "manifest_version": 3,
  "name": "AIMaster · 스마트스토어 상품등록 자동화",
  "version": "1.4.0",
  "version_name": "v1.04",
  "minimum_chrome_version": "120",
  "description": "AI 상세페이지 자동화로 만든 상품을 스마트스토어센터 「상품 등록」 화면에 칸마다 대신 채워 넣습니다.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://smartstore-register.buylife.xyz/*",
    "https://sell.smartstore.naver.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://smartstore-register.buylife.xyz/*"
      ],
      "js": [
        "web-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "스마트스토어 상품등록 자동화",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
