# 블로그 콘텐츠 자동화(콘텐츠 만들기 전용) — 독립 운영 설정값 예시
# 패키지 설치마법사(패키지설치마법사.cmd / .command)를 쓰면 이 값들이 자동으로 .env.local 과 Vercel 에 들어갑니다.
# 손으로 설치할 때만: 이 파일을 프로그램 폴더에 .env.local 로 복사해 값을 채우고, Vercel → Settings → Environment Variables 에도 같은 값을 넣습니다.

# 반드시 true — AIMaster 없이 자체 가입·로그인으로 동작하고, 자동 포스팅(확장 프로그램)을 끕니다
NEXT_PUBLIC_STANDALONE_MODE=true

# 내 사이트 주소(끝에 / 없이). Vercel Domains 에 보이는 주소 또는 연결한 내 도메인
NEXT_PUBLIC_SITE_URL=

# 브라우저 탭 제목에 표시할 내 이름/브랜드(비우면 표시 안 함)
NEXT_PUBLIC_BRAND_NAME=

# Supabase (Project Settings → API Keys) — ANON 칸에는 Publishable key, SERVICE_ROLE 칸에는 Secret key(절대 공개 금지)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 매일 1번 30일 지난 글·이미지·글감을 정리하는 작업의 비밀값(마법사가 자동 생성 — 긴 무작위 문자열)
CRON_SECRET=

# AI 키(OpenAI·Gemini·Claude·Perplexity·YouTube)는 여기에 넣지 않습니다 — 내 사이트 [API키등록·플랫폼연동] 화면에서 저장합니다.
