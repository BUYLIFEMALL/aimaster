{
  "name": "aimaster-codex-statusbar",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run check",
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/run.mjs && node --check src/rates.mjs && node --check src/format.mjs && node --check src/screen.mjs && node --check install.mjs",
    "install-launcher": "node install.mjs",
    "restore-launcher": "node install.mjs --restore",
    "verify-account": "node verify-account.mjs"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0"
  }
}
