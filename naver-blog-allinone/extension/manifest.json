{
  "manifest_version": 3,
  "name": "AIMaster · 네이버 블로그 올인원 자동화",
  "version": "1.08.0",
  "version_name": "v1.08",
  "description": "올인원 마스터에서 생성한 AI 블로그 원고를 네이버 스마트에디터 ONE에 1초 만에 자동 주입합니다.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://naver-blog-allinone.buylife.xyz/*",
    "https://naver-blog-allinone.vercel.app/*",
    "http://localhost:3000/*",
    "https://blog.naver.com/*",
    "https://nid.naver.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://naver-blog-allinone.buylife.xyz/*",
        "https://naver-blog-allinone.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": ["content-web.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://blog.naver.com/*"
      ],
      "js": ["content-naver.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "네이버 블로그 올인원 마스터 PRO",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
